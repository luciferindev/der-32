# Single-translation-unit build of the interpreter (onelua.c).
${CC:-cc} ${CFLAGS:--O2} -std=gnu99 -DLUA_USE_POSIX -o lua onelua.c -lm
mkdir -p "$DESTDIR$PREFIX/bin" "$DESTDIR$PREFIX/share/doc/lua"
install -m 755 lua "$DESTDIR$PREFIX/bin/lua"
install -m 644 README.md "$DESTDIR$PREFIX/share/doc/lua/README.md"
# the MIT licence text lives at the end of lua.h
sed -n '/Copyright (C) 1994/,/^\*\*\*\*/p' lua.h > "$DESTDIR$PREFIX/share/doc/lua/LICENSE"
