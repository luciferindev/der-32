+#	$DER32: Makefile,v 0.1 2026/11/19 $
+#
+# Reachover Makefile: derfetch is developed in the top-level DER/32
+# derfetch/ directory and built into the base system here.
+
+.include <bsd.own.mk>
+
+DERFETCHDIR=	${NETBSDSRCDIR}/../derfetch
+.PATH:		${DERFETCHDIR}
+
+PROG=		derfetch
