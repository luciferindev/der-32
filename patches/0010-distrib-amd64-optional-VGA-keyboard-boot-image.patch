From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DER/32 Project <der32@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:00:00 -0700
Subject: [PATCH 10/14] distrib/amd64: optional VGA/keyboard boot image

Preserve the original serial distribution and add DER32_CONSOLE=pc,
which uses the PC boot console and a wscons login on ttyE0.
---
 distrib/amd64/der32image/Makefile | 19 +++++++++++++++----
 distrib/amd64/der32image/ttys.pc  | 20 ++++++++++++++++++++
 2 files changed, 35 insertions(+), 4 deletions(-)
 create mode 100644 distrib/amd64/der32image/ttys.pc

diff --git a/distrib/amd64/der32image/Makefile b/distrib/amd64/der32image/Makefile
index e0875d6e9b4ace2de9ab49fc3bba3b146f291ee2..f1618ec09ae80487f872c45f4ffc849b70517e40 100644
--- a/distrib/amd64/der32image/Makefile
+++ b/distrib/amd64/der32image/Makefile
@@ -1,7 +1,7 @@
 #	$DER32: Makefile,v 0.1 2026/11/19 $
 #
 # DER/32 bootable disk image for amd64 (raw, MBR + FFSv1 root, serial
-# console on com0).  Built from the release sets with NetBSD's
+# console on com0, or local VGA/keyboard).  Built with NetBSD's
 # Makefile.bootimage; DER/32-specific content is added below.
 #
 # Required:  RELEASEDIR with binary/sets/{base,etc,...}.tgz and
@@ -12,7 +12,20 @@
 .include <bsd.own.mk>
 .include "${NETBSDSRCDIR}/sys/conf/der32.release"
 
+# Keep the original serial image intact, and build a separate PC variant.
+# The console selection must be passed to nbmake for each image build.
+DER32_CONSOLE?= serial
+.if ${DER32_CONSOLE} == "serial"
 LIVEIMGBASE=	der32-${DER32_RELEASE}-${MACHINE}
+INSTALLBOOTOPTIONS=	-o console=com0,speed=9600,timeout=3
+DER32_TTYS=	${.CURDIR}/ttys
+.elif ${DER32_CONSOLE} == "pc"
+LIVEIMGBASE=	der32-${DER32_RELEASE}-${MACHINE}-pc
+INSTALLBOOTOPTIONS=	-o console=pc,timeout=3
+DER32_TTYS=	${.CURDIR}/ttys.pc
+.else
+.error "DER32_CONSOLE must be serial or pc"
+.endif
 LIVEIMAGEMB?=	2048
 SWAPMB=		0
 IMAGEHOSTNAME=	der32
@@ -23,15 +36,13 @@ PRIMARY_BOOT=	bootxx_ffsv1
 SECONDARY_BOOT=	boot
 SECONDARY_BOOT_ARG=
 USE_MBR=	yes
-INSTALLBOOTOPTIONS=	-o console=com0,speed=9600,timeout=3
-
 RC_CONF_EXTRA=	${.CURDIR}/rc.conf.der32
 SPEC_EXTRA=	${.CURDIR}/spec.der32
 
 DER32_ROOT_HASH?=	${.CURDIR}/root.hash
 PWWORK=		${.OBJDIR}/pwwork
 
-IMGFILE_EXTRA=	${.CURDIR}/ttys			etc/ttys \
+IMGFILE_EXTRA=	${DER32_TTYS}			etc/ttys \
 		${PWWORK}/etc/master.passwd	etc/master.passwd \
 		${PWWORK}/etc/passwd		etc/passwd \
 		${PWWORK}/etc/pwd.db		etc/pwd.db \
diff --git a/distrib/amd64/der32image/ttys.pc b/distrib/amd64/der32image/ttys.pc
new file mode 100644
index 0000000000000000000000000000000000000000..34a373dac291fba5358c8064af3c4b6b5c6750b1
--- /dev/null
+++ b/distrib/amd64/der32image/ttys.pc
@@ -0,0 +1,20 @@
+#
+#	from: @(#)ttys	5.1 (Berkeley) 4/17/89
+#	$NetBSD: ttys,v 1.7 2019/09/25 23:09:19 abs Exp $
+#
+# name	getty				type	status		comments
+#
+console	"/usr/libexec/getty Pc"		vt100	off secure
+constty	"/usr/libexec/getty Pc"		vt100	off secure
+ttyE0	"/usr/libexec/getty Pc"		wsvt25	on secure
+ttyE1	"/usr/libexec/getty Pc"		wsvt25	off secure
+ttyE2	"/usr/libexec/getty Pc"		wsvt25	off secure
+ttyE3	"/usr/libexec/getty Pc"		wsvt25	off secure
+tty00	"/usr/libexec/getty std.9600"	vt100 off secure
+tty01	"/usr/libexec/getty std.9600"	unknown off secure
+tty02	"/usr/libexec/getty std.9600"	unknown off secure
+tty03	"/usr/libexec/getty std.9600"	unknown off secure
+tty04	"/usr/libexec/getty std.9600"	unknown off secure
+tty05	"/usr/libexec/getty std.9600"	unknown off secure
+tty06	"/usr/libexec/getty std.9600"	unknown off secure
+tty07	"/usr/libexec/getty std.9600"	unknown off secure
