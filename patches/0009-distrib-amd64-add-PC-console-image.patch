From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DER/32 Project <der32@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:00:00 -0700
Subject: [PATCH 9/9] distrib/amd64: optional VGA/keyboard boot image

Preserve the original serial distribution and add DER32_CONSOLE=pc,
which uses the PC boot console and a wscons login on ttyE0.
Also set root profile ownership for first-login setup.
---

diff --git a/distrib/amd64/der32image/Makefile b/distrib/amd64/der32image/Makefile
--- a/distrib/amd64/der32image/Makefile
+++ b/distrib/amd64/der32image/Makefile
@@ -1,56 +1,67 @@
-#	$DER32: Makefile,v 0.1 2026/11/19 $
-#
-# DER/32 bootable disk image for amd64 (raw, MBR + FFSv1 root, serial
-# console on com0).  Built from the release sets with NetBSD's
-# Makefile.bootimage; DER/32-specific content is added below.
-#
-# Required:  RELEASEDIR with binary/sets/{base,etc,...}.tgz and
-#            kern-DER32.tgz (build.sh sets releasekernel=DER32)
-# Optional:  DER32_EXTRA_DIR  directory merged into the image root
-#            DER32_ROOT_HASH  file holding root's password hash
-
-.include <bsd.own.mk>
-.include "${NETBSDSRCDIR}/sys/conf/der32.release"
-
-LIVEIMGBASE=	der32-${DER32_RELEASE}-${MACHINE}
-LIVEIMAGEMB?=	2048
-SWAPMB=		0
-IMAGEHOSTNAME=	der32
-
-KERN_SET=	kern-DER32
-SETS?=		base etc comp misc man
-PRIMARY_BOOT=	bootxx_ffsv1
-SECONDARY_BOOT=	boot
-SECONDARY_BOOT_ARG=
-USE_MBR=	yes
-INSTALLBOOTOPTIONS=	-o console=com0,speed=9600,timeout=3
-
-RC_CONF_EXTRA=	${.CURDIR}/rc.conf.der32
-SPEC_EXTRA=	${.CURDIR}/spec.der32
-
-DER32_ROOT_HASH?=	${.CURDIR}/root.hash
-PWWORK=		${.OBJDIR}/pwwork
-
-IMGFILE_EXTRA=	${.CURDIR}/ttys			etc/ttys \
-		${PWWORK}/etc/master.passwd	etc/master.passwd \
-		${PWWORK}/etc/passwd		etc/passwd \
-		${PWWORK}/etc/pwd.db		etc/pwd.db \
-		${PWWORK}/etc/spwd.db		etc/spwd.db
-
-.if defined(DER32_EXTRA_DIR)
-IMGDIR_EXTRA=	${DER32_EXTRA_DIR}	.
-.endif
-
-# Root's password database is regenerated with the image's root hash.
-prepare_md_post: ${PWWORK}/etc/spwd.db
-${PWWORK}/etc/spwd.db: ${DER32_ROOT_HASH}
-	rm -rf ${PWWORK}
-	mkdir -p ${PWWORK}/etc
-	hash=$$(cat ${DER32_ROOT_HASH}); \
-	${TOOL_AWK} -F: -v OFS=: -v h="$$hash" \
-	    '$$1 == "root" { $$2 = h } { print }' \
-	    ${NETBSDSRCDIR}/etc/master.passwd > ${PWWORK}/etc/master.passwd
-	${TOOL_PWD_MKDB} -p -d ${PWWORK} ${PWWORK}/etc/master.passwd
-
-
-.include "${NETBSDSRCDIR}/distrib/common/bootimage/Makefile.liveimage"
+#	$DER32: Makefile,v 0.1 2026/11/19 $
+#
+# DER/32 bootable disk image for amd64 (raw, MBR + FFSv1 root, serial
+# console on com0, or local VGA/keyboard).  Built with NetBSD's
+# Makefile.bootimage; DER/32-specific content is added below.
+#
+# Required:  RELEASEDIR with binary/sets/{base,etc,...}.tgz and
+#            kern-DER32.tgz (build.sh sets releasekernel=DER32)
+# Optional:  DER32_EXTRA_DIR  directory merged into the image root
+#            DER32_ROOT_HASH  file holding root's password hash
+
+.include <bsd.own.mk>
+.include "${NETBSDSRCDIR}/sys/conf/der32.release"
+
+# Keep the original serial image intact, and build a separate PC variant.
+# The console selection must be passed to nbmake for each image build.
+DER32_CONSOLE?= serial
+.if ${DER32_CONSOLE} == "serial"
+LIVEIMGBASE=	der32-${DER32_RELEASE}-${MACHINE}
+INSTALLBOOTOPTIONS=	-o console=com0,speed=9600,timeout=3
+DER32_TTYS=	${.CURDIR}/ttys
+.elif ${DER32_CONSOLE} == "pc"
+LIVEIMGBASE=	der32-${DER32_RELEASE}-${MACHINE}-pc
+INSTALLBOOTOPTIONS=	-o console=pc,timeout=3
+DER32_TTYS=	${.CURDIR}/ttys.pc
+.else
+.error "DER32_CONSOLE must be serial or pc"
+.endif
+LIVEIMAGEMB?=	2048
+SWAPMB=		0
+IMAGEHOSTNAME=	der32
+
+KERN_SET=	kern-DER32
+SETS?=		base etc comp misc man
+PRIMARY_BOOT=	bootxx_ffsv1
+SECONDARY_BOOT=	boot
+SECONDARY_BOOT_ARG=
+USE_MBR=	yes
+RC_CONF_EXTRA=	${.CURDIR}/rc.conf.der32
+SPEC_EXTRA=	${.CURDIR}/spec.der32
+
+DER32_ROOT_HASH?=	${.CURDIR}/root.hash
+PWWORK=		${.OBJDIR}/pwwork
+
+IMGFILE_EXTRA=	${DER32_TTYS}			etc/ttys \
+		${PWWORK}/etc/master.passwd	etc/master.passwd \
+		${PWWORK}/etc/passwd		etc/passwd \
+		${PWWORK}/etc/pwd.db		etc/pwd.db \
+		${PWWORK}/etc/spwd.db		etc/spwd.db
+
+.if defined(DER32_EXTRA_DIR)
+IMGDIR_EXTRA=	${DER32_EXTRA_DIR}	.
+.endif
+
+# Root's password database is regenerated with the image's root hash.
+prepare_md_post: ${PWWORK}/etc/spwd.db
+${PWWORK}/etc/spwd.db: ${DER32_ROOT_HASH}
+	rm -rf ${PWWORK}
+	mkdir -p ${PWWORK}/etc
+	hash=$$(cat ${DER32_ROOT_HASH}); \
+	${TOOL_AWK} -F: -v OFS=: -v h="$$hash" \
+	    '$$1 == "root" { $$2 = h } { print }' \
+	    ${NETBSDSRCDIR}/etc/master.passwd > ${PWWORK}/etc/master.passwd
+	${TOOL_PWD_MKDB} -p -d ${PWWORK} ${PWWORK}/etc/master.passwd
+
+
+.include "${NETBSDSRCDIR}/distrib/common/bootimage/Makefile.liveimage"
diff --git a/distrib/amd64/der32image/spec.der32 b/distrib/amd64/der32image/spec.der32
--- a/distrib/amd64/der32image/spec.der32
+++ b/distrib/amd64/der32image/spec.der32
@@ -1,7 +1,8 @@
