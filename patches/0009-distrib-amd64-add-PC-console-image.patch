-./etc/upkg/keys			type=dir  uname=root gname=wheel mode=0755
-./var/lib			type=dir  uname=root gname=wheel mode=0755
-./var/lib/upkg			type=dir  uname=root gname=wheel mode=0755
-./var/cache			type=dir  uname=root gname=wheel mode=0755
-./var/cache/upkg		type=dir  uname=root gname=wheel mode=0755
-./usr/local			type=dir  uname=root gname=wheel mode=0755
+./etc/upkg			type=dir  uname=root gname=wheel mode=0755
+./etc/upkg/keys			type=dir  uname=root gname=wheel mode=0755
+./var/lib			type=dir  uname=root gname=wheel mode=0755
+./var/lib/upkg			type=dir  uname=root gname=wheel mode=0755
+./var/cache			type=dir  uname=root gname=wheel mode=0755
+./var/cache/upkg		type=dir  uname=root gname=wheel mode=0755
+./usr/local			type=dir  uname=root gname=wheel mode=0755
+./root/.profile			type=file uname=root gname=wheel mode=0644
