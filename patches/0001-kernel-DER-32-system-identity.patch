+/*
+ * DER/32 release identification.
+ *
+ * Exposes the DER/32 release metadata generated into vers.c by
+ * sys/conf/newvers.sh (from sys/conf/der32.release) as read-only sysctl
+ * nodes:
+ *
+ *	kern.der32.name		"DER/32"
+ *	kern.der32.release	"0.1"
+ *	kern.der32.codename	"Genesis"
+ *
+ * kern.ostype carries the short system name (uname -s); kern.osrelease
+ * deliberately remains the NetBSD base release for ABI compatibility.
+ */
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$DER32: kern_der32.c,v 0.1 2026/11/19 $");
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+
+extern const char der32_name[];
+extern const char der32_release[];
+extern const char der32_codename[];
+
+SYSCTL_SETUP(sysctl_kern_der32_setup, "sysctl kern.der32 subtree setup")
+{
+	const struct sysctlnode *rnode = NULL;
+
+	if (sysctl_createv(clog, 0, NULL, &rnode,
+	    CTLFLAG_PERMANENT,
+	    CTLTYPE_NODE, "der32",
+	    SYSCTL_DESCR("DER/32 release identification"),
+	    NULL, 0, NULL, 0,
+	    CTL_KERN, CTL_CREATE, CTL_EOL) != 0)
+		return;
+
+	sysctl_createv(clog, 0, &rnode, NULL,
+	    CTLFLAG_PERMANENT,
+	    CTLTYPE_STRING, "name",
+	    SYSCTL_DESCR("Operating system name"),
+	    NULL, 0, __UNCONST(der32_name), 0,
+	    CTL_CREATE, CTL_EOL);
+	sysctl_createv(clog, 0, &rnode, NULL,
+	    CTLFLAG_PERMANENT,
+	    CTLTYPE_STRING, "release",
+	    SYSCTL_DESCR("DER/32 release number"),
+	    NULL, 0, __UNCONST(der32_release), 0,
+	    CTL_CREATE, CTL_EOL);
+	sysctl_createv(clog, 0, &rnode, NULL,
+	    CTLFLAG_PERMANENT,
+	    CTLTYPE_STRING, "codename",
+	    SYSCTL_DESCR("DER/32 release codename"),
+	    NULL, 0, __UNCONST(der32_codename), 0,
+	    CTL_CREATE, CTL_EOL);
+}
