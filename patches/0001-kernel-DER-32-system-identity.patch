diff --git a/sys/conf/der32.release b/sys/conf/der32.release
new file mode 100644
index 0000000000000000000000000000000000000000..c04cf95d25b0f8491e2597aa48197f19ee6621c8
--- /dev/null
+++ b/sys/conf/der32.release
@@ -0,0 +1,12 @@
+# DER/32 release metadata -- the single source of truth for system identity.
+# This file is valid both as POSIX sh (sourced with ".") and as BSD make
+# (.include).  Keep values free of spaces and quotes.
+#
+# DER32_OSTYPE    value of kern.ostype / uname -s
+# DER32_NAME      human-readable system name
+# DER32_RELEASE   DER/32 release number (independent of the NetBSD base)
+# DER32_CODENAME  release codename
+DER32_OSTYPE=DER32
+DER32_NAME=DER/32
+DER32_RELEASE=0.1
+DER32_CODENAME=Genesis
diff --git a/sys/conf/newvers.sh b/sys/conf/newvers.sh
index c45e6cb563d48afa7ec8ab7cfad868d11ce4e0df..6c1cc50fe3265402416556c89e2e1b7db2ef0aed 100644
--- a/sys/conf/newvers.sh
+++ b/sys/conf/newvers.sh
@@ -228,10 +228,15 @@ cwd=$(dirname "$0")
 copyright="$(cat "${cwd}/copyright")"
 osrelcmd=${cwd}/osrelease.sh
 
-ost="NetBSD"
+# DER/32: system identity comes from der32.release.  kern.osrelease keeps the
+# NetBSD base release so that the module loader, binary compatibility checks
+# and the ELF identity note below remain ABI-compatible with the base system.
+. "${cwd}/der32.release"
+ost="${DER32_OSTYPE}"
 osr=$(sh $osrelcmd)
+der32codename_uc=$(echo "${DER32_CODENAME}" | tr '[:lower:]' '[:upper:]')
 
-fullversion="${ost} ${osr} (${id})${reproversion}\n"
+fullversion="${DER32_NAME} ${DER32_RELEASE} ${der32codename_uc} (${id})${reproversion}\n\tNetBSD ${osr} base\n"
 
 # Convert multi-line strings to C source code.
 # Also add an extra blank line to copyright.
@@ -260,6 +265,9 @@ const char sccs[] = "@(#)" ${fullversion_source};
 const char version[] = ${fullversion_source};
 const char buildinfo[] = ${buildinfo_source:-${emptyq}};
 const char kernel_ident[] = "${id}";
+const char der32_name[] = "${DER32_NAME}";
+const char der32_release[] = "${DER32_RELEASE}";
+const char der32_codename[] = "${DER32_CODENAME}";
 const char copyright[] = ${copyright_source};
 _EOF
 
